#!/usr/bin/env python3
"""
Aedes aegypti Variant Calling Pipeline
Portable Snakemake workflow with GATK or Parabricks (GPU) support.
"""

import os
import re
import pandas as pd
from pathlib import Path
from snakemake.utils import validate

# Loads config/config.yaml, then deep-merges config/config.local.yaml when
# present. Both CLI overrides work as usual: --config KEY=VALUE and
# --configfile <extra.yaml> (applied on top).
configfile: "config/config.yaml"
if os.path.exists("config/config.local.yaml"):
    configfile: "config/config.local.yaml"

validate(config, "schemas/config.schema.yaml")

REF_FASTA = config["reference"]["fasta"]
REF_ABS = os.path.abspath(REF_FASTA)
REF_DIR = os.path.dirname(REF_ABS)
REF_INDEX = config["reference"].get("index_prefix") or REF_ABS
REF_FAI = f"{REF_ABS}.fai"
REF_DICT = f"{os.path.splitext(REF_ABS)[0]}.dict"
BWA_INDEX_FILES = expand(f"{REF_INDEX}.{{ext}}", ext=["amb", "ann", "bwt", "pac", "sa"])
KNOWN_VARIANTS = (config["reference"].get("known_variants") or "").strip()
USE_BQSR = bool(KNOWN_VARIANTS) and os.path.exists(KNOWN_VARIANTS)
if KNOWN_VARIANTS and not USE_BQSR:
    print(f"Warning: known_variants not found ({KNOWN_VARIANTS}) — BQSR will be skipped")
SAMPLES_SHEET = config["samples"]["sheet"]
FASTQ_DIR = config["samples"]["fastq_dir"]
TRIMMED_DIR = config["output"]["trimmed_dir"]
ALIGNED_DIR = config["output"]["aligned_dir"]
VARIANT_DIR = config["output"]["variant_dir"]
QC_DIR = config["output"]["qc_dir"]
LOGS_DIR = config["output"]["logs_dir"]

# BAM consumed by the variant callers: recalibrated when BQSR runs with a
# known-sites resource, otherwise the markdup BAM directly (no copy step).
CALL_BAM = f"{ALIGNED_DIR}/{{sample}}.recal.bam" if USE_BQSR else f"{ALIGNED_DIR}/{{sample}}.markdup.bam"

THREADS = config["tools"]["threads"]
JAVA_MEM = config["tools"]["java_mem"]

FASTP_Q = config["tools"]["fastp"]["qualified_quality_phred"]
FASTP_L = config["tools"]["fastp"]["length_required"]
FASTP_DETECT = "--detect_adapter_for_pe" if config["tools"]["fastp"]["detect_adapter_for_pe"] else ""
FASTP_TF1 = config["tools"]["fastp"]["trim_front1"]
FASTP_TF2 = config["tools"]["fastp"]["trim_front2"]
FASTP_TT1 = config["tools"]["fastp"]["trim_tail1"]
FASTP_TT2 = config["tools"]["fastp"]["trim_tail2"]

BWA_K = config["tools"]["bwa"]["min_seed_len"]
BWA_W = config["tools"]["bwa"]["bandwidth"]
BWA_C = config["tools"]["bwa"]["max_occurrences"]  # bwa mem -c (seed occurrence cap)

SAMTOOLS_MEM = config["tools"]["samtools"]["sort_memory"]
SAMTOOLS_RMDUP = "-r" if config["tools"]["samtools"]["markdup_rmdup"] else ""

GATK_ERC = config["tools"]["gatk"]["emit_ref_confidence"]
GATK_MBQ = config["tools"]["gatk"]["min_base_quality_score"]
GATK_SMCT = config["tools"]["gatk"]["standard_min_confidence_threshold_for_calling"]
GATK_GDB_PART = config["tools"]["gatk"].get("genomicsdb_num_partitions", 4)
GATK_HC_SCATTER = config["tools"]["gatk"].get("hc_scatter", 8)

BCFTOOLS_OT = config["tools"]["bcftools"]["output_type"]

# Parabricks settings
USE_PARABRICKS = config["tools"].get("parabricks", {}).get("enabled", False)
PARABRICKS_IMAGE = config["tools"].get("parabricks", {}).get("image", "nvcr.io/nvidia/clara/clara-parabricks:4.3.1-1")
PARABRICKS_MODE = config["tools"].get("parabricks", {}).get("mode", "deepvariant")
USE_EXISTING_BAM = config["tools"].get("parabricks", {}).get("use_existing_bam", False)  # "deepvariant" or "haplotypecaller"

def load_samples(sheet_path, fastq_dir):
    samples = []
    if sheet_path and os.path.exists(sheet_path):
        df = pd.read_csv(sheet_path, sep="\t")
        required_cols = ["sample", "fastq_r1", "fastq_r2"]
        if not all(col in df.columns for col in required_cols):
            raise ValueError(f"Sample sheet must have columns: {required_cols}")
        for _, row in df.iterrows():
            samples.append({"sample": row["sample"], "r1": row["fastq_r1"], "r2": row["fastq_r2"]})
    elif fastq_dir and os.path.exists(fastq_dir):
        fastq_files = list(Path(fastq_dir).glob("*_R1_*.fastq.gz"))
        for r1 in fastq_files:
            sample = r1.name.split("_R1_")[0]
            r2 = r1.parent / r1.name.replace("_R1_", "_R2_")
            if r2.exists():
                samples.append({"sample": sample, "r1": str(r1), "r2": str(r2)})
            else:
                print(f"Warning: No matching R2 for {r1}")
    else:
        raise ValueError("No samples found. Provide samples.tsv or fastq_dir in config.")
    return samples

SAMPLES = load_samples(SAMPLES_SHEET, FASTQ_DIR)
SAMPLE_NAMES = [s["sample"] for s in SAMPLES]

def load_interval_chunks(fai_path, n_chunks):
    """Split whole contigs from a .fai into ~n balanced comma-joined interval
    strings (whole contigs only — required for GenomicsDBImport partitioning
    and safe for HaplotypeCaller scatter/gather). Returns [""] (no intervals,
    i.e. whole genome) when the .fai is missing or n_chunks <= 1."""
    if n_chunks <= 1 or not os.path.exists(fai_path):
        return [""]
    contigs = []
    with open(fai_path) as fh:
        for line in fh:
            parts = line.split("\t")
            if len(parts) >= 2:
                contigs.append((parts[0], int(parts[1])))
    if not contigs:
        return [""]
    n_chunks = min(n_chunks, len(contigs))
    target = sum(length for _, length in contigs) / n_chunks
    chunks, current, current_len = [], [], 0
    for name, length in contigs:
        if current and current_len >= target and len(chunks) < n_chunks - 1:
            chunks.append(",".join(current))
            current, current_len = [], 0
        current.append(name)
        current_len += length
    if current:
        chunks.append(",".join(current))
    return chunks

# Mount the reference, FASTQ, trimmed and known-sites directories into the
# Parabricks container at their host paths, so --ref/--in-fq/--known-vcf can
# use absolute host paths regardless of where the inputs live. The project
# directory itself is mounted at /workspace for outputs.
_INPUT_DIRS = {REF_DIR, os.path.dirname(os.path.abspath(TRIMMED_DIR))}
_INPUT_DIRS |= {os.path.dirname(os.path.abspath(s[d])) for s in SAMPLES for d in ("r1", "r2")}
if KNOWN_VARIANTS:
    _INPUT_DIRS.add(os.path.dirname(os.path.abspath(KNOWN_VARIANTS)))
DOCKER_MOUNTS = " ".join(f'-v "{d}":"{d}":ro' for d in sorted(_INPUT_DIRS))

# Select the filter set that matches the variant caller producing the VCF:
# DeepVariant/GLnexus output has no GATK-only annotations, GATK output has them.
CALLER = PARABRICKS_MODE if USE_PARABRICKS else "gatk"
_BCFTOOLS = config["tools"]["bcftools"]
_CALLER_BCFTOOLS = _BCFTOOLS.get(CALLER, {})
SNP_FILTER = _CALLER_BCFTOOLS.get("snp_filter", _BCFTOOLS.get("snp_filter", "QUAL<30"))
INDEL_FILTER = _CALLER_BCFTOOLS.get("indel_filter", _BCFTOOLS.get("indel_filter", "QUAL<30"))
GENO_FILTER = _CALLER_BCFTOOLS.get("genotype_filter", _BCFTOOLS.get("genotype_filter", "FMT/DP<10 || FMT/GQ<20"))
EXCLUDE_BED = config["reference"].get("exclude_bed", "")

def get_sample_info(wildcards):
    for s in SAMPLES:
        if s["sample"] == wildcards.sample:
            return s
    raise ValueError(f"Sample {wildcards.sample} not found in config")

if USE_PARABRICKS:
    print(f"Using Parabricks (GPU): {PARABRICKS_IMAGE} | mode: {PARABRICKS_MODE}")
print(f"Active filters ({CALLER}): site [SNP] {SNP_FILTER} | [INDEL] {INDEL_FILTER} | geno {GENO_FILTER}")

# ============================================================
# TARGET RULE
# ============================================================

# Keep {sample} from swallowing the per-chunk infix (e.g. "test_1.hc_0"),
# which would make haplotype_caller and gather_gvcfs ambiguous.
wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLE_NAMES),
    chunk=r"\d+"

rule all:
    input:
        f"{QC_DIR}/multiqc_report.html",
        expand(f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz", sample=SAMPLE_NAMES),
        expand(f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz.tbi", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/coverage/{{sample}}.coverage.txt", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/fastp/{{sample}}_fastp.html", sample=SAMPLE_NAMES),
        f"{VARIANT_DIR}/variant_summary.tsv",
        f"{QC_DIR}/alignment_summary.tsv"

# ============================================================
# PARABRICKS RULES (GPU)
# ============================================================

if USE_PARABRICKS:

    if USE_EXISTING_BAM:
        # Skip alignment - BAMs already exist, just declare them
        print(f"Using existing BAMs in {ALIGNED_DIR} (skipping alignment)")
    else:
        rule pbrun_fq2bam:
            input:
                r1=f"{TRIMMED_DIR}/{{sample}}_R1.trim.fastq.gz",
                r2=f"{TRIMMED_DIR}/{{sample}}_R2.trim.fastq.gz",
                ref=REF_ABS,
                bwa_index=BWA_INDEX_FILES,
                fai=REF_FAI,
                dictf=REF_DICT
            params:
                fq1=lambda wildcards: os.path.abspath(f"{TRIMMED_DIR}/{wildcards.sample}_R1.trim.fastq.gz"),
                fq2=lambda wildcards: os.path.abspath(f"{TRIMMED_DIR}/{wildcards.sample}_R2.trim.fastq.gz"),
            output:
                bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
                bai=f"{ALIGNED_DIR}/{{sample}}.markdup.bam.bai"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_fq2bam/{{sample}}.log"
            shell:
                """
                mkdir -p {ALIGNED_DIR} {LOGS_DIR}/pbrun_fq2bam
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    {DOCKER_MOUNTS} \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun fq2bam \
                        --ref {REF_ABS} \
                        --in-fq {params.fq1} {params.fq2} \
                        --out-bam /workspace/{output.bam} \
                        --read-group-sm {wildcards.sample} \
                        --read-group-id {wildcards.sample} \
                        --read-group-pl ILLUMINA \
                        2> {log}
                """

    # BQSR — only defined when a known-sites resource is configured;
    # otherwise callers read the markdup BAM directly (no copy).
    if USE_BQSR:
        rule pbrun_bqsr:
            input:
                bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
                ref=REF_ABS,
                known=KNOWN_VARIANTS,
                fai=REF_FAI,
                dictf=REF_DICT
            output:
                recal_table=temp(f"{ALIGNED_DIR}/{{sample}}.recal.table"),
                bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
                bai=f"{ALIGNED_DIR}/{{sample}}.recal.bam.bai"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_bqsr/{{sample}}.log"
            conda: "../config/environment.yaml"
            shell:
                """
                mkdir -p {ALIGNED_DIR} {LOGS_DIR}/pbrun_bqsr
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    {DOCKER_MOUNTS} \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun bqsr \
                        --ref {REF_ABS} \
                        --in-bam /workspace/{input.bam} \
                        --known-vcf {input.known} \
                        --out-recal-file /workspace/{output.recal_table} \
                        2> {log}
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    {DOCKER_MOUNTS} \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun applybqsr \
                        --ref {REF_ABS} \
                        --in-bam /workspace/{input.bam} \
                        --recal-file /workspace/{output.recal_table} \
                        --out-bam /workspace/{output.bam} \
                        2>> {log}
                samtools index -@{threads} -f {output.bam}
                """

    if PARABRICKS_MODE == "deepvariant":
        rule pbrun_variant_call:
            input:
                bam=CALL_BAM,
                ref=REF_ABS,
                fai=REF_FAI,
                dictf=REF_DICT
            output:
                gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
                tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_deepvariant/{{sample}}.log"
            conda: "../config/environment.yaml"
            shell:
                """
                mkdir -p {VARIANT_DIR} {LOGS_DIR}/pbrun_deepvariant
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    {DOCKER_MOUNTS} \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun deepvariant \
                        --ref {REF_ABS} \
                        --in-bam /workspace/{input.bam} \
                        --out-variants /workspace/{output.gvcf} \
                        --gvcf \
                        2> {log}
                bcftools index -t -f {output.gvcf}
                """
    else:
        rule pbrun_variant_call:
            input:
                bam=CALL_BAM,
                ref=REF_ABS,
                fai=REF_FAI,
                dictf=REF_DICT
            output:
                gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
                tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_haplotypecaller/{{sample}}.log"
            conda: "../config/environment.yaml"
            shell:
                """
                mkdir -p {VARIANT_DIR} {LOGS_DIR}/pbrun_haplotypecaller
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    {DOCKER_MOUNTS} \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun haplotypecaller \
                        --ref {REF_ABS} \
                        --in-bam /workspace/{input.bam} \
                        --out-vcf /workspace/{output.gvcf} \
                        --gvcf \
                        2> {log}
                bcftools index -t -f {output.gvcf}
                """

# ============================================================
# GATK RULES (CPU) - fallback when Parabricks disabled
# ============================================================

else:

    rule align_and_markdup:
        input:
            r1=f"{TRIMMED_DIR}/{{sample}}_R1.trim.fastq.gz",
            r2=f"{TRIMMED_DIR}/{{sample}}_R2.trim.fastq.gz",
            ref=REF_ABS,
            bwa_index=BWA_INDEX_FILES
        output:
            bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
            bai=f"{ALIGNED_DIR}/{{sample}}.markdup.bam.bai"
        threads: THREADS
        log: f"{LOGS_DIR}/align/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {ALIGNED_DIR} {LOGS_DIR}/align
            bwa mem -t {threads} -k {BWA_K} -w {BWA_W} -c {BWA_C} \
                -R '@RG\\tID:{wildcards.sample}\\tSM:{wildcards.sample}\\tPL:ILLUMINA' \
                {input.ref} {input.r1} {input.r2} \
                2> {log} \
                | samtools sort -@{threads} -m {SAMTOOLS_MEM} -n - \
                | samtools fixmate -m - - \
                | samtools sort -@{threads} -m {SAMTOOLS_MEM} - \
                | samtools markdup -@{threads} {SAMTOOLS_RMDUP} - {output.bam}
            samtools index -@{threads} {output.bam}
            """

    # BQSR — only defined when a known-sites resource is configured;
    # otherwise HaplotypeCaller reads the markdup BAM directly (no copy).
    if USE_BQSR:
        rule bqsr:
            input:
                bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
                ref=REF_ABS,
                known=KNOWN_VARIANTS,
                fai=REF_FAI,
                dictf=REF_DICT
            output:
                recal_table=temp(f"{ALIGNED_DIR}/{{sample}}.recal.table"),
                bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
                bai=f"{ALIGNED_DIR}/{{sample}}.recal.bam.bai"
            threads: THREADS
            log: f"{LOGS_DIR}/bqsr/{{sample}}.log"
            conda: "../config/environment.yaml"
            shell:
                """
                mkdir -p {ALIGNED_DIR} {LOGS_DIR}/bqsr
                gatk --java-options "-Xmx{JAVA_MEM}" BaseRecalibrator \
                    -R {input.ref} -I {input.bam} \
                    --known-sites {input.known} \
                    -O {output.recal_table} 2> {log}
                gatk --java-options "-Xmx{JAVA_MEM}" ApplyBQSR \
                    -R {input.ref} -I {input.bam} \
                    --bqsr-recal-file {output.recal_table} \
                    -O {output.bam} 2>> {log}
                samtools index -@{threads} {output.bam}
                """

    # Scattered HaplotypeCaller: balanced whole-contig interval chunks
    # (a single chunk with no intervals = whole genome when no .fai/n<=1).
    HC_CHUNKS = load_interval_chunks(REF_FAI, GATK_HC_SCATTER)
    HC_N_CHUNKS = len(HC_CHUNKS)

    rule haplotype_caller:
        input:
            bam=CALL_BAM,
            ref=REF_ABS,
            fai=REF_FAI,
            dictf=REF_DICT
        output:
            gvcf=temp(f"{VARIANT_DIR}/{{sample}}.hc_{{chunk}}.g.vcf.gz"),
            tbi=temp(f"{VARIANT_DIR}/{{sample}}.hc_{{chunk}}.g.vcf.gz.tbi")
        params:
            intervals=lambda wildcards: HC_CHUNKS[int(wildcards.chunk)]
        threads: THREADS
        log: f"{LOGS_DIR}/haplotype_caller/{{sample}}_{{chunk}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}/haplotype_caller
            if [ -n "{params.intervals}" ]; then
                INTERVALS="--intervals {params.intervals}"
            else
                INTERVALS=""
            fi
            gatk --java-options "-Xmx{JAVA_MEM}" HaplotypeCaller \
                -R {input.ref} -I {input.bam} -O {output.gvcf} \
                $INTERVALS \
                --emit-ref-confidence {GATK_ERC} \
                --min-base-quality-score {GATK_MBQ} \
                --standard-min-confidence-threshold-for-calling {GATK_SMCT} \
                --native-pair-hmm-threads {threads} \
                2> {log}
            gatk --java-options "-Xmx{JAVA_MEM}" IndexFeatureFile -I {output.gvcf} 2>> {log}
            """

    rule gather_gvcfs:
        input:
            vcfs=lambda wildcards: expand(
                f"{VARIANT_DIR}/{wildcards.sample}.hc_{{chunk}}.g.vcf.gz",
                chunk=range(HC_N_CHUNKS)),
            tbis=lambda wildcards: expand(
                f"{VARIANT_DIR}/{wildcards.sample}.hc_{{chunk}}.g.vcf.gz.tbi",
                chunk=range(HC_N_CHUNKS))
        output:
            gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
            tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
        threads: 2
        log: f"{LOGS_DIR}/gather_gvcfs/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}/gather_gvcfs
            GVCF_ARGS=$(for f in {input.vcfs}; do printf -- "-I %s " $f; done)
            gatk --java-options "-Xmx{JAVA_MEM}" GatherVcfs $GVCF_ARGS -O {output.gvcf} 2> {log}
            gatk --java-options "-Xmx{JAVA_MEM}" IndexFeatureFile -I {output.gvcf} 2>> {log}
            """

# ============================================================
# JOINT GENOTYPING
# ============================================================
# DeepVariant gVCFs carry no <NON_REF> allele, so GATK GenomicsDBImport /
# GenotypeGVCFs cannot consume them — those are joint-genotyped with GLnexus
# (DeepVariant preset). GATK-style gVCFs (CPU HaplotypeCaller or Parabricks
# haplotypecaller mode) go through GenomicsDBImport + GenotypeGVCFs; GLnexus's
# DeepVariant preset must NOT be used on them.

if USE_PARABRICKS and PARABRICKS_MODE == "deepvariant":

    rule genotype_gvcfs:
        input:
            gvcfs=expand(f"{VARIANT_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLE_NAMES),
            ref=REF_ABS
        output:
            vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
            tbi=f"{VARIANT_DIR}/cohort.raw.vcf.gz.tbi"
        threads: THREADS
        log: f"{LOGS_DIR}/genotype_gvcfs.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}
            rm -rf {VARIANT_DIR}/.glnexus.db
            glnexus_cli --config DeepVariant \
                --dir {VARIANT_DIR}/.glnexus.db \
                --mem-gbytes 8 --threads {threads} \
                {input.gvcfs} \
                2> {log} \
                | bcftools view -Oz -o {output.vcf}
            rm -rf {VARIANT_DIR}/.glnexus.db
            bcftools index -t {output.vcf}
            """

else:

    rule genotype_gvcfs:
        input:
            gvcfs=expand(f"{VARIANT_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLE_NAMES),
            ref=REF_ABS,
            fai=REF_FAI,
            dictf=REF_DICT
        output:
            vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
            tbi=f"{VARIANT_DIR}/cohort.raw.vcf.gz.tbi"
        threads: THREADS
        log: f"{LOGS_DIR}/genotype_gvcfs.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}
            INTERVAL_ARGS=$(cut -f1 {input.fai} | sed 's/^/-L /' | tr '\n' ' ')
            GVCF_ARGS=$(for f in {input.gvcfs}; do printf -- "-V %s " $f; done)
            rm -rf {VARIANT_DIR}/genomicsdb
            gatk --java-options "-Xmx{JAVA_MEM}" GenomicsDBImport \
                $GVCF_ARGS \
                $INTERVAL_ARGS \
                --merge-contigs-into-num-partitions {GATK_GDB_PART} \
                --reference {input.ref} \
                --genomicsdb-workspace-path {VARIANT_DIR}/genomicsdb \
                2> {log}
            gatk --java-options "-Xmx{JAVA_MEM}" GenotypeGVCFs \
                -R {input.ref} \
                -V gendb://{VARIANT_DIR}/genomicsdb \
                -O {output.vcf} \
                2>> {log}
            rm -rf {VARIANT_DIR}/genomicsdb
            """

# ============================================================
# SHARED RULES (both modes)
# ============================================================

# Trimming runs in both modes (Parabricks fq2bam does not trim).
rule fastp:
    input:
        r1=lambda wildcards: os.path.abspath(get_sample_info(wildcards)["r1"]),
        r2=lambda wildcards: os.path.abspath(get_sample_info(wildcards)["r2"])
    output:
        r1=temp(f"{TRIMMED_DIR}/{{sample}}_R1.trim.fastq.gz"),
        r2=temp(f"{TRIMMED_DIR}/{{sample}}_R2.trim.fastq.gz"),
        html=f"{QC_DIR}/fastp/{{sample}}_fastp.html",
        json=f"{QC_DIR}/fastp/{{sample}}_fastp.json"
    threads: THREADS
    log: f"{LOGS_DIR}/fastp/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR}/fastp {TRIMMED_DIR} {LOGS_DIR}/fastp
        fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} \
            -h {output.html} -j {output.json} --thread {threads} \
            --qualified_quality_phred {FASTP_Q} --length_required {FASTP_L} \
            {FASTP_DETECT} \
            --trim_front1 {FASTP_TF1} --trim_front2 {FASTP_TF2} \
            --trim_tail1 {FASTP_TT1} --trim_tail2 {FASTP_TT2} \
            2> {log}
        """

rule flagstat:
    input: bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam"
    output: f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt"
    threads: 2
    log: f"{LOGS_DIR}/flagstat/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR}/flagstat {LOGS_DIR}/flagstat
        samtools flagstat -@{threads} {input.bam} > {output} 2> {log}
        """

rule coverage:
    input: bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam"
    output: f"{QC_DIR}/coverage/{{sample}}.coverage.txt"
    threads: 2
    log: f"{LOGS_DIR}/coverage/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR}/coverage {LOGS_DIR}/coverage
        samtools coverage {input.bam} > {output} 2> {log}
        """

rule filter_variants:
    input:
        vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
        ref=REF_FASTA
    output:
        vcf=f"{VARIANT_DIR}/cohort.filtered.vcf.gz",
        tbi=f"{VARIANT_DIR}/cohort.filtered.vcf.gz.tbi"
    threads: THREADS
    log: f"{LOGS_DIR}/filter_variants.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}
        EXCLUDE=""
        if [ -n "{EXCLUDE_BED}" ] && [ -f "{EXCLUDE_BED}" ]; then
            EXCLUDE="-T ^{EXCLUDE_BED}"
        fi
        bcftools view -m2 -M2 -v snps $EXCLUDE -Ou {input.vcf} 2> {log} \
            | bcftools filter -e '{SNP_FILTER}' -s SNP_HARDFAIL -Ou 2>> {log} \
            | bcftools filter -e '{GENO_FILTER}' -S . -Oz -o {VARIANT_DIR}/.snps.tmp.vcf.gz 2>> {log}
        bcftools index -t {VARIANT_DIR}/.snps.tmp.vcf.gz
        bcftools view -m2 -M2 -v indels $EXCLUDE -Ou {input.vcf} 2>> {log} \
            | bcftools filter -e '{INDEL_FILTER}' -s INDEL_HARDFAIL -Ou 2>> {log} \
            | bcftools filter -e '{GENO_FILTER}' -S . -Oz -o {VARIANT_DIR}/.indels.tmp.vcf.gz 2>> {log}
        bcftools index -t {VARIANT_DIR}/.indels.tmp.vcf.gz
        bcftools concat -a -Oz -o {output.vcf} \
            {VARIANT_DIR}/.snps.tmp.vcf.gz {VARIANT_DIR}/.indels.tmp.vcf.gz 2>> {log}
        bcftools index -t -f {output.vcf}
        rm -f {VARIANT_DIR}/.snps.tmp.vcf.gz* {VARIANT_DIR}/.indels.tmp.vcf.gz*
        """

rule split_vcf:
    input:
        vcf=f"{VARIANT_DIR}/cohort.filtered.vcf.gz"
    output:
        vcf=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz",
        tbi=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz.tbi"
    threads: 2
    log: f"{LOGS_DIR}/split_vcf/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}/split_vcf
        bcftools view -s {wildcards.sample} -O {BCFTOOLS_OT} -o {output.vcf} {input.vcf} 2> {log}
        bcftools index -t {output.vcf} 2>> {log}
        """

rule variant_stats:
    input: vcf=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz"
    output: f"{VARIANT_DIR}/{{sample}}.variant_stats.txt"
    threads: 2
    log: f"{LOGS_DIR}/variant_stats/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}/variant_stats
        bcftools stats -f PASS,. {input.vcf} > {output} 2> {log}
        """

rule variant_summary:
    input: expand(f"{VARIANT_DIR}/{{sample}}.variant_stats.txt", sample=SAMPLE_NAMES)
    output: f"{VARIANT_DIR}/variant_summary.tsv"
    log: f"{LOGS_DIR}/variant_summary.log"
    run:
        summary_rows = []
        for f in input:
            sample = Path(f).stem.replace(".variant_stats", "")
            with open(f) as fh:
                for line in fh:
                    if line.startswith("SN"):
                        parts = line.strip().split("\t")
                        if len(parts) >= 4:
                            summary_rows.append({"sample": sample, "metric": parts[2], "value": parts[3]})
        pd.DataFrame(summary_rows).to_csv(output[0], sep="\t", index=False)

rule alignment_summary:
    input: expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES)
    output: f"{QC_DIR}/alignment_summary.tsv"
    log: f"{LOGS_DIR}/alignment_summary.log"
    run:
        import re
        summary_rows = []
        for f in input:
            sample = Path(f).stem.replace(".flagstat", "")
            mapped_done = False
            with open(f) as fh:
                for line in fh:
                    if "mapped (" in line and not mapped_done:
                        match = re.search(r"(\d+\.?\d*)%", line)
                        if match:
                            summary_rows.append({"sample": sample, "metric": "mapping_rate_pct", "value": match.group(1)})
                            mapped_done = True
                    if "properly paired" in line.lower():
                        match = re.search(r"(\d+\.?\d*)%", line)
                        if match:
                            summary_rows.append({"sample": sample, "metric": "properly_paired_pct", "value": match.group(1)})
        pd.DataFrame(summary_rows).to_csv(output[0], sep="\t", index=False)

rule multiqc:
    input:
        fastp_json=expand(f"{QC_DIR}/fastp/{{sample}}_fastp.json", sample=SAMPLE_NAMES),
        flagstat=expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES),
        coverage=expand(f"{QC_DIR}/coverage/{{sample}}.coverage.txt", sample=SAMPLE_NAMES),
        variant_stats=expand(f"{VARIANT_DIR}/{{sample}}.variant_stats.txt", sample=SAMPLE_NAMES)
    output: f"{QC_DIR}/multiqc_report.html"
    log: f"{LOGS_DIR}/multiqc.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR} {LOGS_DIR}
        multiqc {QC_DIR}/fastp {QC_DIR}/flagstat {QC_DIR}/coverage {input.variant_stats} \
            -o {QC_DIR} --force 2> {log}
        """