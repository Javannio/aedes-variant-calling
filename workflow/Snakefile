#!/usr/bin/env python3
"""
Aedes aegypti Dengue Variant Calling Pipeline
Portable Snakemake workflow with GATK or Parabricks (GPU) support.
"""

import os
import yaml
import pandas as pd
from pathlib import Path

config_file = "config/config.local.yaml"
if not os.path.exists(config_file):
    config_file = "config/config.yaml"
if not os.path.exists(config_file):
    raise FileNotFoundError("Config file not found. Create config/config.local.yaml")

with open(config_file) as f:
    config = yaml.safe_load(f)

REF_FASTA = config["reference"]["fasta"]
REF_INDEX = config["reference"]["index_prefix"]
SAMPLES_SHEET = config["samples"]["sheet"]
FASTQ_DIR = config["samples"]["fastq_dir"]
TRIMMED_DIR = config["output"]["trimmed_dir"]
ALIGNED_DIR = config["output"]["aligned_dir"]
VARIANT_DIR = config["output"]["variant_dir"]
QC_DIR = config["output"]["qc_dir"]
LOGS_DIR = config["output"]["logs_dir"]

THREADS = config["tools"]["threads"]
JAVA_MEM = config["tools"]["java_mem"]

FASTP_Q = config["tools"]["fastp"]["qualified_quality_phred"]
FASTP_L = config["tools"]["fastp"]["length_required"]
FASTP_DETECT = "--detect_adapter_for_pe" if config["tools"]["fastp"]["detect_adapter_for_pe"] else ""
FASTP_TF1 = config["tools"]["fastp"]["trim_front1"]
FASTP_TF2 = config["tools"]["fastp"]["trim_front2"]
FASTP_TT1 = config["tools"]["fastp"]["trim_tail1"]
FASTP_TT2 = config["tools"]["fastp"]["trim_tail2"]

BWA_K = config["tools"]["bwa"]["min_seed_len"]
BWA_W = config["tools"]["bwa"]["bandwidth"]
BWA_KK = config["tools"]["bwa"]["max_occurrences"]

SAMTOOLS_MEM = config["tools"]["samtools"]["sort_memory"]
SAMTOOLS_RMDUP = "-r" if config["tools"]["samtools"]["markdup_rmdup"] else ""

GATK_ERC = config["tools"]["gatk"]["emit_ref_confidence"]
GATK_MBQ = config["tools"]["gatk"]["min_base_quality_score"]
GATK_SMCT = config["tools"]["gatk"]["standard_min_confidence_threshold_for_calling"]
GATK_GMC = config["tools"]["gatk"]["genotype_min_confidence"]

BCFTOOLS_FILTER = config["tools"]["bcftools"]["filter_expr"]
BCFTOOLS_FNAME = config["tools"]["bcftools"]["filter_name"]
BCFTOOLS_OT = config["tools"]["bcftools"]["output_type"]

# Parabricks settings
USE_PARABRICKS = config["tools"].get("parabricks", {}).get("enabled", False)
PARABRICKS_IMAGE = config["tools"].get("parabricks", {}).get("image", "nvcr.io/nvidia/clara/clara-parabricks:4.3.1-1")
PARABRICKS_MODE = config["tools"].get("parabricks", {}).get("mode", "deepvariant")
USE_EXISTING_BAM = config["tools"].get("parabricks", {}).get("use_existing_bam", False)  # "deepvariant" or "haplotypecaller"

def load_samples(sheet_path, fastq_dir):
    samples = []
    if sheet_path and os.path.exists(sheet_path):
        df = pd.read_csv(sheet_path, sep="\t")
        required_cols = ["sample", "fastq_r1", "fastq_r2"]
        if not all(col in df.columns for col in required_cols):
            raise ValueError(f"Sample sheet must have columns: {required_cols}")
        for _, row in df.iterrows():
            samples.append({"sample": row["sample"], "r1": row["fastq_r1"], "r2": row["fastq_r2"]})
    elif fastq_dir and os.path.exists(fastq_dir):
        fastq_files = list(Path(fastq_dir).glob("*_R1_*.fastq.gz"))
        for r1 in fastq_files:
            sample = r1.name.split("_R1_")[0]
            r2 = r1.parent / r1.name.replace("_R1_", "_R2_")
            if r2.exists():
                samples.append({"sample": sample, "r1": str(r1), "r2": str(r2)})
            else:
                print(f"Warning: No matching R2 for {r1}")
    else:
        raise ValueError("No samples found. Provide samples.tsv or fastq_dir in config.")
    return samples

SAMPLES = load_samples(SAMPLES_SHEET, FASTQ_DIR)
SAMPLE_NAMES = [s["sample"] for s in SAMPLES]

def get_sample_info(wildcards):
    for s in SAMPLES:
        if s["sample"] == wildcards.sample:
            return s
    raise ValueError(f"Sample {wildcards.sample} not found in config")

if USE_PARABRICKS:
    print(f"Using Parabricks (GPU): {PARABRICKS_IMAGE} | mode: {PARABRICKS_MODE}")

# ============================================================
# TARGET RULE
# ============================================================
rule all:
    input:
        f"{QC_DIR}/multiqc_report.html",
        expand(f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz", sample=SAMPLE_NAMES),
        expand(f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz.tbi", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/coverage/{{sample}}.coverage.txt", sample=SAMPLE_NAMES),
        expand(f"{QC_DIR}/fastp/{{sample}}_fastp.html", sample=SAMPLE_NAMES),
        f"{VARIANT_DIR}/variant_summary.tsv",
        f"{QC_DIR}/alignment_summary.tsv"

# ============================================================
# PARABRICKS RULES (GPU)
# ============================================================

if USE_PARABRICKS:

    if USE_EXISTING_BAM:
        # Skip alignment - BAMs already exist, just declare them
        print(f"Using existing BAMs in {ALIGNED_DIR} (skipping alignment)")
    else:
        rule pbrun_fq2bam:
            input:
                r1=lambda wildcards: get_sample_info(wildcards)["r1"],
                r2=lambda wildcards: get_sample_info(wildcards)["r2"],
                ref=REF_FASTA
            output:
                bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
                bai=f"{ALIGNED_DIR}/{{sample}}.markdup.bam.bai"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_fq2bam/{{sample}}.log"
            shell:
                """
                mkdir -p {ALIGNED_DIR} {LOGS_DIR}/pbrun_fq2bam
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    -v /home/romar:/home/romar \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun fq2bam \
                        --ref /home/romar/ref/GCF_002204515.2_AaegL5.0_genomic.fna \
                        --in-fq {input.r1} {input.r2} \
                        --out-bam /workspace/{output.bam} \
                        --read-group-sm {wildcards.sample} \
                        --read-group-id {wildcards.sample} \
                        --read-group-pl ILLUMINA \
                        2> {log}
                """

    # BQSR - just copy since no known variants
    rule pbrun_bqsr:
        input:
            bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
            ref=REF_FASTA
        output:
            recal_table=temp(f"{ALIGNED_DIR}/{{sample}}.recal.table"),
            bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
            bai=f"{ALIGNED_DIR}/{{sample}}.recal.bam.bai"
        threads: THREADS
        log: f"{LOGS_DIR}/pbrun_bqsr/{{sample}}.log"
        shell:
            """
            mkdir -p {ALIGNED_DIR} {LOGS_DIR}/pbrun_bqsr
            touch {output.recal_table}
            cp {input.bam} {output.bam}
            samtools index -@{threads} {output.bam}
            """

    if PARABRICKS_MODE == "deepvariant":
        rule pbrun_variant_call:
            input:
                bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
                ref=REF_FASTA
            output:
                gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
                tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_deepvariant/{{sample}}.log"
            conda: "../config/environment.yaml"
            shell:
                """
                mkdir -p {VARIANT_DIR} {LOGS_DIR}/pbrun_deepvariant
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    -v /home/romar:/home/romar \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun deepvariant \
                        --ref /home/romar/ref/GCF_002204515.2_AaegL5.0_genomic.fna \
                        --in-bam /workspace/{input.bam} \
                        --out-variants /workspace/{output.gvcf} \
                        --gvcf \
                        2> {log}
                bcftools index -t -f {output.gvcf}
                """
    else:
        rule pbrun_variant_call:
            input:
                bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
                ref=REF_FASTA
            output:
                gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
                tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
            threads: THREADS
            log: f"{LOGS_DIR}/pbrun_haplotypecaller/{{sample}}.log"
            shell:
                """
                mkdir -p {VARIANT_DIR} {LOGS_DIR}/pbrun_haplotypecaller
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    -v /home/romar:/home/romar \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun haplotypecaller \
                        --ref /home/romar/ref/GCF_002204515.2_AaegL5.0_genomic.fna \
                        --in-bam /workspace/{input.bam} \
                        --out-vcf /workspace/{output.gvcf} \
                        --gvcf \
                        2> {log}
                """

    rule pbrun_genotypegvfs:
        input:
            gvcfs=expand(f"{VARIANT_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLE_NAMES),
            ref=REF_FASTA
        output:
            vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
            tbi=f"{VARIANT_DIR}/cohort.raw.vcf.gz.tbi"
        threads: THREADS
        log: f"{LOGS_DIR}/genotype_gvcfs.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}
            : > {log}
            SAMPLE_VCFS=""
            for g in {input.gvcfs}; do
                v="${{g%.g.vcf.gz}}.vcf.gz"
                docker run --rm --gpus all \
                    -v $(pwd):/workspace \
                    -v /home/romar:/home/romar \
                    -w /workspace \
                    {PARABRICKS_IMAGE} \
                    pbrun genotypegvcf \
                        --ref /home/romar/ref/GCF_002204515.2_AaegL5.0_genomic.fna \
                        --in-gvcf /workspace/$g \
                        --out-vcf /workspace/$v \
                        2>> {log}
                SAMPLE_VCFS="$SAMPLE_VCFS $v"
            done
            for v in $SAMPLE_VCFS; do
                bcftools annotate -x FORMAT/VAF -Oz -o "${{v%.vcf.gz}}.novaf.vcf.gz" $v 2>> {log}
                bcftools index -t "${{v%.vcf.gz}}.novaf.vcf.gz"
            done
            CLEAN_VCFS=$(for v in $SAMPLE_VCFS; do printf -- "%s " "${{v%.vcf.gz}}.novaf.vcf.gz"; done)
            bcftools merge -Oz -o {output.vcf} $CLEAN_VCFS 2>> {log}
            bcftools index -t {output.vcf}
            """

# ============================================================
# GATK RULES (CPU) - fallback when Parabricks disabled
# ============================================================

else:

    rule fastp:
        input:
            r1=lambda wildcards: get_sample_info(wildcards)["r1"],
            r2=lambda wildcards: get_sample_info(wildcards)["r2"]
        output:
            r1=temp(f"{TRIMMED_DIR}/{{sample}}_R1.trim.fastq.gz"),
            r2=temp(f"{TRIMMED_DIR}/{{sample}}_R2.trim.fastq.gz"),
            html=f"{QC_DIR}/fastp/{{sample}}_fastp.html",
            json=f"{QC_DIR}/fastp/{{sample}}_fastp.json"
        threads: THREADS
        log: f"{LOGS_DIR}/fastp/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {QC_DIR}/fastp {TRIMMED_DIR} {LOGS_DIR}/fastp
            fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} \
                -h {output.html} -j {output.json} --thread {threads} \
                --qualified_quality_phred {FASTP_Q} --length_required {FASTP_L} \
                {FASTP_DETECT} \
                --trim_front1 {FASTP_TF1} --trim_front2 {FASTP_TF2} \
                --trim_tail1 {FASTP_TT1} --trim_tail2 {FASTP_TT2} \
                2> {log}
            """

    rule align_and_markdup:
        input:
            r1=f"{TRIMMED_DIR}/{{sample}}_R1.trim.fastq.gz",
            r2=f"{TRIMMED_DIR}/{{sample}}_R2.trim.fastq.gz",
            ref=REF_FASTA
        output:
            bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
            bai=f"{ALIGNED_DIR}/{{sample}}.markdup.bam.bai"
        threads: THREADS
        log: f"{LOGS_DIR}/align/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {ALIGNED_DIR} {LOGS_DIR}/align
            bwa mem -t {threads} -k {BWA_K} -w {BWA_W} -K {BWA_KK} \
                -R '@RG\\tID:{wildcards.sample}\\tSM:{wildcards.sample}\\tPL:ILLUMINA' \
                {input.ref} {input.r1} {input.r2} \
                | samtools sort -@{threads} -m {SAMTOOLS_MEM} -n - \
                | samtools fixmate -m - - \
                | samtools sort -@{threads} -m {SAMTOOLS_MEM} - \
                | samtools markdup -@{threads} {SAMTOOLS_RMDUP} - {output.bam}
            samtools index -@{threads} {output.bam}
            """

    rule bqsr:
        input:
            bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam",
            ref=REF_FASTA
        output:
            recal_table=temp(f"{ALIGNED_DIR}/{{sample}}.recal.table"),
            bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
            bai=f"{ALIGNED_DIR}/{{sample}}.recal.bam.bai"
        threads: THREADS
        log: f"{LOGS_DIR}/bqsr/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {ALIGNED_DIR} {LOGS_DIR}/bqsr
            if [ -f "{config[reference][known_variants]}" ]; then
                gatk --java-options "-Xmx{JAVA_MEM}" BaseRecalibrator \
                    -R {input.ref} -I {input.bam} \
                    --known-sites {config[reference][known_variants]} \
                    -O {output.recal_table} 2> {log}
                gatk --java-options "-Xmx{JAVA_MEM}" ApplyBQSR \
                    -R {input.ref} -I {input.bam} \
                    --bqsr-recal-file {output.recal_table} \
                    -O {output.bam} 2>> {log}
            else
                touch {output.recal_table}
                cp {input.bam} {output.bam}
                samtools index -@{threads} {output.bam}
            fi
            """

    rule haplotype_caller:
        input:
            bam=f"{ALIGNED_DIR}/{{sample}}.recal.bam",
            ref=REF_FASTA
        output:
            gvcf=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz",
            tbi=f"{VARIANT_DIR}/{{sample}}.g.vcf.gz.tbi"
        threads: THREADS
        log: f"{LOGS_DIR}/haplotype_caller/{{sample}}.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}/haplotype_caller
            gatk --java-options "-Xmx{JAVA_MEM}" HaplotypeCaller \
                -R {input.ref} -I {input.bam} -O {output.gvcf} \
                --emit-ref-confidence {GATK_ERC} \
                --min-base-quality-score {GATK_MBQ} \
                --standard-min-confidence-threshold-for-calling {GATK_SMCT} \
                --native-pair-hmm-threads {threads} \
                2> {log}
            gatk --java-options "-Xmx{JAVA_MEM}" IndexFeatureFile -I {output.gvcf} 2>> {log}
            """

    rule genotype_gvcfs:
        input:
            gvcfs=expand(f"{VARIANT_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLE_NAMES),
            ref=REF_FASTA
        output:
            vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
            tbi=f"{VARIANT_DIR}/cohort.raw.vcf.gz.tbi"
        threads: THREADS
        log: f"{LOGS_DIR}/genotype_gvcfs.log"
        conda: "../config/environment.yaml"
        shell:
            """
            mkdir -p {VARIANT_DIR} {LOGS_DIR}
            echo {input.gvcfs} | tr ' ' '\n' > {VARIANT_DIR}/gvcf.list
            gatk --java-options "-Xmx{JAVA_MEM}" GenotypeGVCFs \
                -R {input.ref} -V {VARIANT_DIR}/gvcf.list \
                -O {output.vcf} \
                --genotype-min-confidence {GATK_GMC} \
                2> {log}
            gatk --java-options "-Xmx{JAVA_MEM}" IndexFeatureFile -I {output.vcf} 2>> {log}
            rm {VARIANT_DIR}/gvcf.list
            """

# ============================================================
# SHARED RULES (both modes)
# ============================================================

rule flagstat:
    input: bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam"
    output: f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt"
    threads: 2
    log: f"{LOGS_DIR}/flagstat/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR}/flagstat {LOGS_DIR}/flagstat
        samtools flagstat -@{threads} {input.bam} > {output} 2> {log}
        """

rule coverage:
    input: bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam"
    output: f"{QC_DIR}/coverage/{{sample}}.coverage.txt"
    threads: 2
    log: f"{LOGS_DIR}/coverage/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR}/coverage {LOGS_DIR}/coverage
        samtools coverage {input.bam} > {output} 2> {log}
        """

# fastp outputs for MultiQC (skip if Parabricks did trimming)
if USE_PARABRICKS:
    rule fastp_stub:
        input: bam=f"{ALIGNED_DIR}/{{sample}}.markdup.bam"
        output:
            html=f"{QC_DIR}/fastp/{{sample}}_fastp.html",
            json=f"{QC_DIR}/fastp/{{sample}}_fastp.json"
        shell:
            """
            mkdir -p {QC_DIR}/fastp
            echo '{{"sample_id": "{wildcards.sample}", "tool": "parabricks_fq2bam"}}' > {output.json}
            echo "<html><body><h1>Parabricks fq2bam - {wildcards.sample}</h1></body></html>" > {output.html}
            """

rule filter_variants:
    input:
        vcf=f"{VARIANT_DIR}/cohort.raw.vcf.gz",
        ref=REF_FASTA
    output:
        vcf=f"{VARIANT_DIR}/cohort.filtered.vcf.gz",
        tbi=f"{VARIANT_DIR}/cohort.filtered.vcf.gz.tbi"
    threads: THREADS
    log: f"{LOGS_DIR}/filter_variants.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}
        gatk --java-options "-Xmx{JAVA_MEM}" VariantFiltration \
            -R {input.ref} -V {input.vcf} -O {output.vcf} \
            --filter-expression '{BCFTOOLS_FILTER}' \
            --filter-name '{BCFTOOLS_FNAME}' \
            2> {log}
        gatk --java-options "-Xmx{JAVA_MEM}" IndexFeatureFile -I {output.vcf} 2>> {log}
        """

rule split_vcf:
    input:
        vcf=f"{VARIANT_DIR}/cohort.filtered.vcf.gz"
    output:
        vcf=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz",
        tbi=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz.tbi"
    threads: 2
    log: f"{LOGS_DIR}/split_vcf/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}/split_vcf
        bcftools view -s {wildcards.sample} -O {BCFTOOLS_OT} -o {output.vcf} {input.vcf} 2> {log}
        bcftools index -t {output.vcf} 2>> {log}
        """

rule variant_stats:
    input: vcf=f"{VARIANT_DIR}/{{sample}}.filtered.vcf.gz"
    output: f"{VARIANT_DIR}/{{sample}}.variant_stats.txt"
    threads: 2
    log: f"{LOGS_DIR}/variant_stats/{{sample}}.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {VARIANT_DIR} {LOGS_DIR}/variant_stats
        bcftools stats {input.vcf} > {output} 2> {log}
        """

rule variant_summary:
    input: expand(f"{VARIANT_DIR}/{{sample}}.variant_stats.txt", sample=SAMPLE_NAMES)
    output: f"{VARIANT_DIR}/variant_summary.tsv"
    log: f"{LOGS_DIR}/variant_summary.log"
    run:
        summary_rows = []
        for f in input:
            sample = Path(f).stem.replace(".variant_stats", "")
            with open(f) as fh:
                for line in fh:
                    if line.startswith("SN"):
                        parts = line.strip().split("\t")
                        if len(parts) >= 4:
                            summary_rows.append({"sample": sample, "metric": parts[2], "value": parts[3]})
        pd.DataFrame(summary_rows).to_csv(output[0], sep="\t", index=False)

rule alignment_summary:
    input: expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES)
    output: f"{QC_DIR}/alignment_summary.tsv"
    log: f"{LOGS_DIR}/alignment_summary.log"
    run:
        import re
        summary_rows = []
        for f in input:
            sample = Path(f).stem.replace(".flagstat", "")
            mapped_done = False
            with open(f) as fh:
                for line in fh:
                    if "mapped (" in line and not mapped_done:
                        match = re.search(r"(\d+\.?\d*)%", line)
                        if match:
                            summary_rows.append({"sample": sample, "metric": "mapping_rate_pct", "value": match.group(1)})
                            mapped_done = True
                    if "properly paired" in line.lower():
                        match = re.search(r"(\d+\.?\d*)%", line)
                        if match:
                            summary_rows.append({"sample": sample, "metric": "properly_paired_pct", "value": match.group(1)})
        pd.DataFrame(summary_rows).to_csv(output[0], sep="\t", index=False)

rule multiqc:
    input:
        fastp_json=expand(f"{QC_DIR}/fastp/{{sample}}_fastp.json", sample=SAMPLE_NAMES),
        flagstat=expand(f"{QC_DIR}/flagstat/{{sample}}.flagstat.txt", sample=SAMPLE_NAMES),
        coverage=expand(f"{QC_DIR}/coverage/{{sample}}.coverage.txt", sample=SAMPLE_NAMES),
        variant_stats=expand(f"{VARIANT_DIR}/{{sample}}.variant_stats.txt", sample=SAMPLE_NAMES)
    output: f"{QC_DIR}/multiqc_report.html"
    log: f"{LOGS_DIR}/multiqc.log"
    conda: "../config/environment.yaml"
    shell:
        """
        mkdir -p {QC_DIR} {LOGS_DIR}
        multiqc {QC_DIR}/fastp {QC_DIR}/flagstat {QC_DIR}/coverage {input.variant_stats} \
            -o {QC_DIR} --force 2> {log}
        """