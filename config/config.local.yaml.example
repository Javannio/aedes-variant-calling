# Aedes aegypti Variant Calling - Local Configuration Example
# Copy to config/config.local.yaml and modify for your system.
# This file is deep-merged over config/config.yaml — only override what
# differs on your machine; everything else falls back to the defaults.

reference:
  fasta: "/path/to/ref/GCF_002204515.2_AaegL5.0_genomic.fna"
  index_prefix: "/path/to/ref/GCF_002204515.2_AaegL5.0_genomic.fna"
  known_variants: ""
  # Optional: BED of regions to exclude (RepeatMasker, low mappability)
  exclude_bed: ""

samples:
  sheet: "config/samples.tsv"
  # fastq_dir: "data/fastq"   # alternative to sample sheet

tools:
  threads: 8
  java_mem: "16g"

  # GPU-accelerated mode (requires Docker + Parabricks image + NVIDIA GPU)
  parabricks:
    enabled: false
    image: "nvcr.io/nvidia/clara/clara-parabricks:4.3.1-1"
    mode: "deepvariant"
    use_existing_bam: false
